{
  // "DualSense" or "DualSenseEdge". Edge lets the Claw's M1/M2 become real back paddles.
  "Model": "DualSense",

  // "Usb": identical to a DualSense on a USB cable - required for PS Remote Play.
  // "Bluetooth": Bluetooth report protocol (simple 0x01 -> 78-byte 0x31 with CRC).
  "Transport": "Usb",

  "Port": 3240,
  "AutoAttach": true,          // runs "usbip attach -r 127.0.0.1 -b 1-1" for you
  "UsbIpPath": null,           // e.g. "C:\\Program Files\\USBip\\usbip.exe"

  "ReportIntervalMs": 4.0,     // ~250 Hz, like a DualSense on Bluetooth
  "StartInEnhancedMode": false,
  "MacAddress": "02:C1:A5:5E:00:01",

  "XInputSlot": 0,             // the Claw's built-in pad
  // 0 = raw stick values like a real DualSense; the game applies its own dead zone.
  "StickDeadZone": 0.0,
  // If small stick movements still feel late, try 0.10-0.20 to cancel the game's dead zone.
  "StickAntiDeadZone": 0.0,
  "TriggerDigitalThreshold": 0,

  "RumblePassthrough": true,
  "RumbleStrength": 1.0,

  // Claw (Xbox layout) -> DualSense
  "ButtonMap": {
    "A": "Cross", "B": "Circle", "X": "Square", "Y": "Triangle",
    "LB": "L1", "RB": "R1", "LS": "L3", "RS": "R3",
    "View": "Create", "Menu": "Options", "Guide": "PS",
    "DPadUp": "DPadUp", "DPadDown": "DPadDown", "DPadLeft": "DPadLeft", "DPadRight": "DPadRight"
  },

  // Set M1/M2 in MSI Center M to send these keys, then they become DualSense buttons.
  // With Model = "DualSenseEdge" you can use "EdgeBackL" / "EdgeBackR" instead.
  "KeyBindings": [
    { "Key": "F13", "Target": "TouchpadClick" },
    { "Key": "F14", "Target": "Mute" }
  ],

  // Hold several Claw buttons together to press a DualSense button.
  "Combos": [
    { "Buttons": [ "View", "Menu" ], "Target": "TouchpadClick", "SuppressSources": true }
  ],

  "Motion": {
    "Enabled": true,
    "SensorIntervalMs": 4,
    // DualSense axis <- Claw sensor axis. Flip a sign if an axis moves the wrong way in game.
    "GyroX": "+X", "GyroY": "+Z", "GyroZ": "-Y",
    "AccelX": "-X", "AccelY": "-Z", "AccelZ": "+Y",
    "GyroScale": 1.0
  }
}
